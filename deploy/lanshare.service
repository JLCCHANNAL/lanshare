[Unit]
Description=LANShare file-sharing web app
After=network-online.target
Wants=network-online.target

[Service]
User=lanshare
Group=lanshare
EnvironmentFile=-/etc/default/lanshare
WorkingDirectory=/opt/lanshare
ExecStart=/usr/bin/python3 -m lanshare.server serve
UMask=0007
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
