[Unit]
Description=LANShare network helper (switch LAN profile, answer <name>.local)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/lanshare-netd
ExecStart=/usr/bin/python3 /opt/lanshare-netd/netd.py serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
