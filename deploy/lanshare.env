# LANShare settings (read by systemd from /etc/default/lanshare)
LANSHARE_ROOT=/srv/share
LANSHARE_DATA=/var/lib/lanshare
LANSHARE_HOST=0.0.0.0
LANSHARE_PORT=8080
LANSHARE_NAME=แชร์ไฟล์องค์กร
# maximum size per uploaded file, in bytes (default 4 GiB)
LANSHARE_MAX_UPLOAD=4294967296
LANSHARE_SESSION_HOURS=12
